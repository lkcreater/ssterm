#!/bin/sh
# ssterm-mcp: the stdio bridge to ssterm's MCP endpoint (SST-041, ADR 0009 A8).
#
# An MCP client starts this as a stdio server. It connects to the ssterm Unix socket, sends the line the endpoint
# expects first, then pipes MCP JSON-RPC both ways unchanged. Secrets come from the environment or a private file,
# never from argv (visible to `ps`). Only macOS base system tools are used, so nothing else has to be installed.
#
#   SSTERM_MCP_SOCKET           absolute path of the socket (the ssterm profile's mcp/ssterm.sock)
#   SSTERM_MCP_CREDENTIAL       a credential issued by ssterm (agents ssterm starts)
#   SSTERM_MCP_CREDENTIAL_FILE  external clients: absolute path of the file holding this client's credential. It is
#                               the client's own secret: ssterm cannot read or revoke the file (Revoke invalidates it).
#   SSTERM_MCP_PAIRING_TOKEN    the one-time token from Settings > AI Agent > External MCP clients, used only while the
#                               credential file is missing: once the user approves the client in ssterm, the bridge
#                               writes the credential it receives to SSTERM_MCP_CREDENTIAL_FILE (mode 0600)
#   SSTERM_MCP_CLIENT_NAME      the name ssterm shows for approval (ASCII letters, digits, spaces and . _ ( ) + @ -),
#                               unique among paired clients
#
# A refused pairing or client credential is answered by ssterm with one `{"error":"<code>"}` line; the bridge reports it on
# stderr and exits non-zero. When ssterm drops an established connection (revoke, lock, quit), nc only notices on the
# client's later writes or when the client closes stdin; the client's requests just go unanswered until then.
# The byte checks below use the C locale, so ranges such as A-Z mean ASCII only.
LC_ALL=C
export LC_ALL
# Each connection runs as a background pipeline while the script sits in `wait`, which a trapped signal ends at once: when
# ssterm refuses, the reader signals the script, so the bridge exits now (the pipeline's cat and nc only end when the
# client next writes or closes stdin, and they hold none of the client's output streams).
trap 'exit 69' USR2
trap 'exit 77' USR1
case "$SSTERM_MCP_SOCKET" in
  /*) ;;
  *) echo "ssterm-mcp: SSTERM_MCP_SOCKET must be an absolute path" >&2; exit 64 ;;
esac
if [ -z "$SSTERM_MCP_CREDENTIAL" ] && [ -n "$SSTERM_MCP_CREDENTIAL_FILE" ]; then
  case "$SSTERM_MCP_CREDENTIAL_FILE" in
    /*) ;;
    *) echo "ssterm-mcp: SSTERM_MCP_CREDENTIAL_FILE must be an absolute path" >&2; exit 64 ;;
  esac
  if [ -s "$SSTERM_MCP_CREDENTIAL_FILE" ]; then
    IFS= read -r SSTERM_MCP_CREDENTIAL < "$SSTERM_MCP_CREDENTIAL_FILE"
  else
    # First run: pair with the one-time token, then keep the credential ssterm returns.
    case "$SSTERM_MCP_PAIRING_TOKEN" in
      "" | *[!A-Za-z0-9_-]*) echo "ssterm-mcp: no credential file yet and SSTERM_MCP_PAIRING_TOKEN is missing or malformed" >&2; exit 64 ;;
    esac
    name=${SSTERM_MCP_CLIENT_NAME:-MCP client}
    case "$name" in
      *[!A-Za-z0-9._\(\)+@\ -]*) echo "ssterm-mcp: SSTERM_MCP_CLIENT_NAME has unsupported characters" >&2; exit 64 ;;
    esac
    exec 3<&0
    { printf '{"pair":"%s","name":"%s"}\n' "$SSTERM_MCP_PAIRING_TOKEN" "$name"; exec /bin/cat <&3; } 2>/dev/null | /usr/bin/nc -U "$SSTERM_MCP_SOCKET" 2>/dev/null | {
      IFS= read -r first || { echo "ssterm-mcp: pairing was refused or expired, or ssterm is not running" >&2; exit 69; }
      case "$first" in
        '{"error":"name-in-use"}') echo "ssterm-mcp: a paired client already has this name; set another SSTERM_MCP_CLIENT_NAME" >&2; kill -USR2 $$; exit 69 ;;
        '{"error":'*) echo "ssterm-mcp: pairing was refused or expired (or external clients are off, or ssterm is locked)" >&2; kill -USR2 $$; exit 69 ;;
      esac
      credential=${first#\{\"credential\":\"}
      credential=${credential%\"\}}
      case "$credential" in
        "" | *[!A-Za-z0-9_-]*) echo "ssterm-mcp: unexpected reply from ssterm" >&2; kill -USR2 $$; exit 69 ;;
      esac
      file=$SSTERM_MCP_CREDENTIAL_FILE
      ( umask 077 && /bin/mkdir -p "$(/usr/bin/dirname "$file")" && printf '%s\n' "$credential" > "$file.$$" && /bin/mv -f "$file.$$" "$file" ) ||
        { echo "ssterm-mcp: could not save the credential file" >&2; kill -USR2 $$; exit 73; }
      exec /bin/cat
    } &
    wait $!
    exit $?
  fi
fi
case "$SSTERM_MCP_CREDENTIAL" in
  "" | *[!A-Za-z0-9_-]*) echo "ssterm-mcp: SSTERM_MCP_CREDENTIAL is missing or malformed" >&2; exit 64 ;;
esac
# The reader passes everything through after checking the first line for a refusal. nc and cat get no stderr: only this
# script reports, and nothing it leaves behind holds the client's stderr open.
exec 3<&0
{ printf '{"credential":"%s"}\n' "$SSTERM_MCP_CREDENTIAL"; exec /bin/cat <&3; } 2>/dev/null | /usr/bin/nc -U "$SSTERM_MCP_SOCKET" 2>/dev/null | {
  IFS= read -r first || { echo "ssterm-mcp: no answer from ssterm (not running, or the connection was refused or closed)" >&2; exit 69; }
  case "$first" in
    '{"error":'*) echo "ssterm-mcp: ssterm refused this credential (the client was revoked, external clients are off, or ssterm is locked)" >&2; kill -USR1 $$; exit 77 ;;
  esac
  printf '%s\n' "$first"
  exec /bin/cat
} &
wait $!
