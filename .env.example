# ssterm build-time settings. Copy to .env.local (gitignored) and fill in; never commit real values.
#
# Google sign-in for the app lock (ADR 0004). Use an OAuth client of type "Desktop app" from Google Cloud Console.
# Either set the client ID and secret:
SSTERM_GOOGLE_CLIENT_ID=
SSTERM_GOOGLE_CLIENT_SECRET=
# ...or point to the downloaded client JSON instead (leave the two lines above empty):
# SSTERM_GOOGLE_CLIENT_FILE=~/Downloads/client_secret_XXXX.apps.googleusercontent.com.json
#
# Redirect used by ssterm (no Console change needed for Desktop app clients): http://127.0.0.1:55411/oauth/callback
